# 값은 로컬에서 직접 채운다. 실제 값을 커밋하지 않는다.

# 급식 운영일(serviceDate)을 끊는 IANA 시간대. 비밀 값이 아니다.
# 한국에서 운영한다면 Asia/Seoul. 비워 두면 기동에 실패한다.
# 기본값을 두지 않는 이유: UTC로 조용히 넘어가면 KST 00:00~08:59 동안
# 대시보드가 전날 급식을 오늘로 보여 준다.
BAPPLANNER_BUSINESS_ZONE_ID=Asia/Seoul

DB_URL=
DB_USERNAME=
DB_PASSWORD=

# 최소 32바이트 임의 문자열
JWT_SIGNING_KEY=

# JWT_SIGNING_KEY와 다른, 최소 32바이트 임의 문자열
PHONE_VERIFICATION_HMAC_KEY=

# 내부 수집 경로(/internal/v1/**)가 받는 서비스 토큰. 최소 32자.
# CCTV 수집기 같은 다른 프로세스가 이 값을 들고 온다.
# 아래 AI_SERVICE_TOKEN과 다른 값이어야 한다. 하나를 돌려쓰면 한쪽이 새는
# 순간 양쪽이 같이 뚫린다.
BAPPLANNER_INTERNAL_SERVICE_TOKEN=

# 관리자 웹(Vercel 등)의 Origin. 쉼표로 여러 개. 정확한 https://host[:port] 만 허용
# (와일드카드/http/끝 슬래시 불가). 비우면 브라우저 cross-origin 호출은 모두 거절.
# 예: https://babplanner-admin.vercel.app
BAPPLANNER_CORS_ALLOWED_ORIGINS=

# 공개 시연 배포에서는 반드시 true. 휴대폰 인증/회원가입 API를 403으로 막는다.
# (SMS_MODE=noop 은 인증번호를 응답에 싣기 때문.) 로컬 개발은 false 또는 비움.
BAPPLANNER_DEMO_DISABLE_SIGNUP=false

# AI 서비스(FastAPI) 주소와 토큰. 수요/발주가 같은 프로세스이므로
# 주소와 토큰도 하나만 둔다. 주소는 비밀이 아니다.
AI_SERVICE_BASE_URL=
AI_SERVICE_TOKEN=

# 잔반 인증 승인 시 지급 포인트(0 이상 정수). 비워 두지 말 것(빈 값은 기동 실패). 쿠폰 발급 규칙은 미정.
REWARD_WASTE_APPROVAL_POINTS=100

# 로컬/개발에서만 noop. 운영에서는 실제 SMS 어댑터를 등록한다.
SMS_MODE=

# 로컬 E2E용 개발 사용자. local/dev 프로필에서만 동작한다.
DEV_USER_ENABLED=
DEV_USER_PHONE=
DEV_USER_PASSWORD=
DEV_USER_STUDENT_ID=
DEV_USER_NAME=

# 로컬 E2E용 설문 fixture. local/dev 프로필에서만 동작한다.
DEV_SURVEY_ENABLED=

# 관리자 웹 시연용 샘플 데이터(local/dev 프로필 전용). 기본 false.
# production에서 true로 두면 기동에 실패한다. 생성과 정리는 ACTION으로 따로 명시한다.
#   BAPPLANNER_DEMO_DATA_ACTION=seed     시연 데이터 생성(반복 실행해도 중복 없음)
#   BAPPLANNER_DEMO_DATA_ACTION=cleanup  시연 데이터만 선별 삭제
#   BAPPLANNER_DEMO_DATA_DRY_RUN=true    실제 저장/삭제 없이 건수만 계산(롤백)
BAPPLANNER_DEMO_DATA_ENABLED=false
BAPPLANNER_DEMO_DATA_ACTION=
BAPPLANNER_DEMO_DATA_DRY_RUN=false
