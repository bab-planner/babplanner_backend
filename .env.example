# 값은 로컬에서 직접 채운다. 실제 값을 커밋하지 않는다.
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# 최소 32바이트 임의 문자열
JWT_SIGNING_KEY=

# JWT_SIGNING_KEY와 다른, 최소 32바이트 임의 문자열
PHONE_VERIFICATION_HMAC_KEY=

# 로컬/개발에서만 noop. 운영에서는 실제 SMS 어댑터를 등록한다.
SMS_MODE=

# 로컬 E2E용 개발 사용자. local/dev 프로필에서만 동작한다.
DEV_USER_ENABLED=
DEV_USER_PHONE=
DEV_USER_PASSWORD=
DEV_USER_STUDENT_ID=
DEV_USER_NAME=

# 로컬 E2E용 설문 fixture. local/dev 프로필에서만 동작한다.
DEV_SURVEY_ENABLED=
